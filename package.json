{
  "name": "naturopata-digitale",
  "version": "1.3.36",
  "private": true,
  "description": "Erbario con 70 piante officinali, manuale, fitoalimurgia, sopravvivenza, biblioteca storica, quiz e assistente locale Neura. PWA statica in italiano, anche offline.",
  "author": "Danilo D'Auria",
  "license": "MIT",
  "keywords": [
    "naturopatia",
    "fitoterapia",
    "fitoalimurgia",
    "piante officinali",
    "PWA",
    "offline"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit:parafrasi": "node scripts/audit-parafrasi.cjs",
    "serve": "python3 -m http.server 3000 --bind 0.0.0.0",
    "icons": "python3 scripts/make_icons.py",
    "vademecum": "sh -c '[ -x .venv/bin/python ] && .venv/bin/python scripts/build_vademecum.py || python3 scripts/build_vademecum.py'",
    "fogli": "sh -c '[ -x .venv/bin/python ] && P=.venv/bin/python || P=python3; $P scripts/build_come_installare_pdf.py && $P scripts/build_scheda_rapida_pdf.py'",
    "link": "node scripts/check-links.cjs",
    "link:esterni": "node scripts/check-links.cjs --esterni",
    "desktop:prepare": "node scripts/prepare-desktop.cjs",
    "backup": "node scripts/backup.cjs",
    "rilascio": "npm test && npm run fogli && npm run desktop:prepare && npm test && npm run backup",
    "test": "node tests/verify.cjs && node tests/dom-test.cjs && node tests/interfacce.cjs",
    "test:interfacce": "node tests/interfacce.cjs",
    "test:data": "node tests/verify.cjs",
    "test:dom": "node tests/dom-test.cjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
