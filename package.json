{
  "name": "naturopata-digitale",
  "version": "1.2.0",
  "private": true,
  "description": "Erbario con 60 piante officinali, manuale, fitoalimurgia, sopravvivenza, biblioteca storica, quiz e assistente locale Neura. PWA statica in italiano, anche offline.",
  "author": "Danilo D'Auria",
  "license": "MIT",
  "keywords": [
    "naturopatia",
    "fitoterapia",
    "fitoalimurgia",
    "piante officinali",
    "PWA",
    "offline"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "python3 -m http.server 3000 --bind 0.0.0.0",
    "icons": "python3 scripts/make_icons.py",
    "vademecum": "sh -c '[ -x .venv/bin/python ] && .venv/bin/python scripts/build_vademecum.py || python3 scripts/build_vademecum.py'",
    "desktop:prepare": "node scripts/prepare-desktop.cjs",
    "test": "node tests/verify.cjs && node tests/dom-test.cjs",
    "test:data": "node tests/verify.cjs",
    "test:dom": "node tests/dom-test.cjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
